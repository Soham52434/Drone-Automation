# Copy to .env and fill in locally. Never commit .env.
# Google AI Studio API key: used by the alert classifier and the language model (summaries, chat, analytics).
GOOGLE_API_KEY=

# Optional: override the hosted models (see "Configuration" in README.md).
# Each LLM setting may be a comma-separated chain; later models take over on errors.
# DRONE_DECISION_MODEL=
# DRONE_SUMMARY_MODEL=
# DRONE_CHAT_MODEL=
